
PORT=5000
NODE_ENV=development

# Optional: Real MongoDB connection URI.
# If omitted or if local MongoDB is not running, NexusPole automatically uses its robust in-memory polar data store with realistic NCPOR seed datasets.
MONGODB_URI=mongodb://localhost:27017/nexuspole
JWT_SECRET=replace_with_a_long_random_secret

# External intelligence providers. Keep these values server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_UNITS=metric
